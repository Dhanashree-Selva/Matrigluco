# =============================================================================
# Matrigluco Web Frontend — Environment Configuration Contract (.env.example)
# Copy to .env.local for local development. Never commit secret credentials!
# All variables with VITE_ are compiled into client bundles and visible to users.
# =============================================================================

# FastAPI API Base URL (Default local development endpoint)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Canonical Public Website URL (Used for Open Graph & canonical meta links)
VITE_SITE_URL=http://localhost:5173

# Application Environment Mode (development | staging | production)
VITE_APP_ENV=development
