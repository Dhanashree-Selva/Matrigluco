<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/care_background">

    <com.matrigluco.core.ui.layout.OrbitFormContainer
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/orbit_screen_padding">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/orbit_space_24">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_matrigluco_mark"
                android:contentDescription="@string/auth_brand_name" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/orbit_space_12"
                android:text="@string/auth_brand_name"
                android:textAppearance="@style/Orbit.Text.Title"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_recovery_title"
            android:textAppearance="@style/Orbit.Text.Display"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/orbit_space_8"
            android:text="@string/auth_recovery_body"
            android:textAppearance="@style/Orbit.Text.BodyMuted" />

        <com.matrigluco.core.designsystem.component.OrbitInputLayout
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/orbit_space_32"
            android:inputType="textEmailAddress"
            app:orbitLabel="@string/auth_email"
            app:orbitRequired="true" />

        <TextView
            android:id="@+id/feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/orbit_space_16"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/Orbit.Text.BodyMuted"
            android:visibility="gone" />

        <com.matrigluco.core.designsystem.component.OrbitButton
            android:id="@+id/submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/orbit_space_24"
            app:orbitText="@string/auth_send_recovery" />

        <com.matrigluco.core.designsystem.component.OrbitButton
            android:id="@+id/back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/orbit_space_12"
            app:orbitText="@string/auth_back_to_sign_in"
            app:orbitVariant="quiet" />
    </com.matrigluco.core.ui.layout.OrbitFormContainer>
</ScrollView>
