<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/orbit_surface_outline"
    android:layout_marginVertical="3dp"
    android:paddingHorizontal="@dimen/orbit_space_16"
    android:paddingVertical="@dimen/orbit_space_12"
    android:minHeight="48dp">

    <LinearLayout
        android:id="@+id/recordDateCol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/recordDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aug 27, 2026"
            android:textAppearance="@style/Orbit.Text.BodyStrong"
            android:textColor="@color/care_ink" />

        <TextView
            android:id="@+id/recordTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01:17 PM"
            android:textAppearance="@style/Orbit.Text.Caption"
            android:textColor="@color/care_text_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/recordValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="150 mg/dL"
            android:textAppearance="@style/Orbit.Text.BodyStrong"
            android:textColor="@color/care_pink" />

        <TextView
            android:id="@+id/recordMetricName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fasting Glucose"
            android:textAppearance="@style/Orbit.Text.Caption"
            android:textColor="@color/care_text_muted" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
