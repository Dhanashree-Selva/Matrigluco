<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reportsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/care_background"
    android:orientation="vertical">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">

                <!-- 1. Vault Summary Card -->
                <LinearLayout
                    android:id="@+id/vaultSummaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_report_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_huge_shield_24"
                            app:tint="@color/care_pink" />

                        <TextView
                            style="@style/Orbit.Text.Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/reports_vault_summary_title"
                            android:textColor="@color/care_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/vaultTotalBadge"
                            style="@style/Orbit.Text.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_chip_reviewed"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/care_text_secondary"
                            android:textSize="11sp"
                            tools:text="5 recorded reports" />
                    </LinearLayout>

                    <TextView
                        style="@style/Orbit.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/reports_vault_summary_desc"
                        android:textColor="@color/care_text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/needsReviewBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_status_chip_needs_review"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_huge_warning_24"
                            app:tint="@color/care_pink" />

                        <TextView
                            android:id="@+id/needsReviewBannerText"
                            style="@style/Orbit.Text.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/care_pink"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            tools:text="2 reports require biomarker review" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. State Selector Pills & Vault Index -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_state_selector_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/tabAll"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_state_selector_tab_active"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="ALL 0"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabNeedsReview"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.2"
                        android:background="@drawable/bg_state_selector_tab_inactive"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="NEEDS REVIEW 0"
                        android:textColor="@color/care_text_secondary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabReviewed"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.1"
                        android:background="@drawable/bg_state_selector_tab_inactive"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="REVIEWED 0"
                        android:textColor="@color/care_text_secondary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 3. Primary Upload Action Button -->
                <FrameLayout
                    android:id="@+id/btnUploadReport"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_upload_report_action"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_huge_add_24"
                            app:tint="#FFFFFF" />

                        <TextView
                            style="@style/Orbit.Text.LabelStrong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reports_upload_action"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Offline Notice Banner -->
                <TextView
                    android:id="@+id/offlineBanner"
                    style="@style/Orbit.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_status_chip_reviewed"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/reports_offline_notice"
                    android:textColor="@color/care_text_secondary"
                    android:visibility="gone" />

                <!-- 4. Reports List RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/reportsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_report_card" />

                <!-- Empty State Component -->
                <com.matrigluco.core.designsystem.component.OrbitEmptyState
                    android:id="@+id/emptyView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/loadingProgress"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="32dp"
                    android:indeterminateTint="@color/care_pink"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
