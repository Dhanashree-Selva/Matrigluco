<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/care_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_source_pill" />

    <!-- Report Identity Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_file_type_plate">

            <ImageView
                android:id="@+id/detailFileIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_huge_document_24"
                app:tint="@color/care_pink" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detailFileName"
                style="@style/Orbit.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/care_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="OGTT_Lab_Report.png" />

            <TextView
                android:id="@+id/detailUploadedMeta"
                style="@style/Orbit.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/care_text_tertiary"
                android:textSize="12sp"
                tools:text="Uploaded Aug 18, 2026 at 3:12 PM" />
        </LinearLayout>

        <TextView
            android:id="@+id/detailStatusChip"
            style="@style/Orbit.Text.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_chip_reviewed"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/care_success"
            android:textSize="11.5sp"
            tools:text="✓ Review completed" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/care_border" />

    <!-- Full Extracted Biomarkers Section -->
    <TextView
        style="@style/Orbit.Text.Eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EXTRACTED BIOMARKERS &amp; LAB VALUES"
        android:textColor="@color/care_pink"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/detailExtractedList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_report_card"
        android:orientation="vertical"
        android:padding="12dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical">

        <!-- Download Clinical PDF Button -->
        <FrameLayout
            android:id="@+id/btnDownloadClinicalPdf"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_source_pill"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_huge_download_24"
                    app:tint="@color/care_pink" />

                <TextView
                    style="@style/Orbit.Text.LabelStrong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reports_download_pdf"
                    android:textColor="@color/care_pink"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Review Extracted Values Button (if needs review) -->
        <FrameLayout
            android:id="@+id/btnReviewExtraction"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_upload_report_action"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/reports_review_action"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Delete Report Button -->
        <TextView
            android:id="@+id/btnDeleteReport"
            style="@style/Orbit.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Delete this report"
            android:textColor="@color/care_danger"
            android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>
