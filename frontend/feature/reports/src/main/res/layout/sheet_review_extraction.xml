<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/care_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_source_pill" />

    <TextView
        style="@style/Orbit.Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reports_review_action"
        android:textColor="@color/care_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        style="@style/Orbit.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Verify or correct extracted biomarker values before saving."
        android:textColor="@color/care_text_secondary"
        android:textSize="13sp" />

    <!-- Editable Fields Container -->
    <LinearLayout
        android:id="@+id/reviewFieldsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" />

    <!-- Save & Confirm Button -->
    <FrameLayout
        android:id="@+id/btnSaveReview"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_upload_report_action"
        android:clickable="true"
        android:focusable="true">

        <TextView
            style="@style/Orbit.Text.LabelStrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/reports_save_changes"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
