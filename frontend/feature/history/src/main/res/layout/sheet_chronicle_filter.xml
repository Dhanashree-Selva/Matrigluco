<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/care_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_source_pill" />

    <!-- Sheet Title -->
    <TextView
        style="@style/Orbit.Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/history_filter_title"
        android:textColor="@color/care_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Section 1: Event Sources -->
    <TextView
        style="@style/Orbit.Text.Eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:text="@string/history_filter_sources_label"
        android:textColor="@color/care_pink" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/sourceChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSourceAll"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/history_source_all" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSourceAssessments"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_source_assessments" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSourceReadings"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_source_readings" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSourceReports"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_source_reports" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSourceConsultations"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_source_consultations" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Section 2: Month Scope -->
    <TextView
        style="@style/Orbit.Text.Eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:text="@string/history_filter_months_label"
        android:textColor="@color/care_pink" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/monthChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMonthAll"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="All Time" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.matrigluco.core.designsystem.component.OrbitButton
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            app:orbitText="@string/history_filter_reset" />

        <com.matrigluco.core.designsystem.component.OrbitButton
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:orbitText="@string/history_filter_apply" />
    </LinearLayout>
</LinearLayout>
