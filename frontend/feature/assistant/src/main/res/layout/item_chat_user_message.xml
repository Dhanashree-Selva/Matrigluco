<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_user_bubble"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            style="@style/Orbit.Text.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assistant_role_you"
            android:textColor="@color/care_pink"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/userMessageBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/care_text_primary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            tools:text="What daily lifestyle and dietary factors influence glucose levels?" />

        <TextView
            android:id="@+id/userMessageTime"
            style="@style/Orbit.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:textColor="@color/care_text_tertiary"
            android:textSize="10sp"
            tools:text="10:30 AM" />
    </LinearLayout>
</LinearLayout>
