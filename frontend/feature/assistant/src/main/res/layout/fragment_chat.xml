<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/care_background"
    android:orientation="vertical">

    <!-- Center Workspace: Clean Welcome State OR Full-Height Message Thread -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Clean Welcome & Prompt Rail Container (Visible when no messages) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/emptyContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="blocksDescendants"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <!-- Glowing Assistant Avatar Badge -->
                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_source_pill">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_matrigluco_mark"
                        app:tint="@color/care_pink" />
                </FrameLayout>

                <!-- Welcome Headline -->
                <TextView
                    style="@style/Orbit.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/assistant_welcome_title"
                    android:textColor="@color/care_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Subtitle Description -->
                <TextView
                    style="@style/Orbit.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:lineSpacingExtra="3.5dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Ask anything about gestational diabetes, glucose readings, or clinical risk factors."
                    android:textColor="@color/care_text_secondary"
                    android:textSize="13sp" />

                <!-- Compact Clickable Context Capsule Pill -->
                <LinearLayout
                    android:id="@+id/contextCapsule"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_source_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:id="@+id/contextShieldIcon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_huge_shield_24"
                        app:tint="@color/care_pink" />

                    <TextView
                        android:id="@+id/contextStatusLabel"
                        style="@style/Orbit.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health context: Allowed"
                        android:textColor="@color/care_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Orbit.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="· Clinical RAG"
                        android:textColor="@color/care_text_tertiary"
                        android:textSize="11sp" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_huge_chevron_right_24"
                        app:tint="@color/care_text_tertiary" />
                </LinearLayout>

                <!-- Suggested Inquiries Section -->
                <TextView
                    style="@style/Orbit.Text.Eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/assistant_suggested_inquiries"
                    android:textColor="@color/care_pink" />

                <!-- Prompt Rail (Horizontal RecyclerView) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/promptRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_prompt_card" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Full-Height Active Message Thread RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messagesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:stackFromEnd="true"
            tools:listitem="@layout/item_chat_assistant_message" />

        <ProgressBar
            android:id="@+id/chatLoading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/care_pink"
            android:visibility="gone" />

        <TextView
            android:id="@+id/offlineBanner"
            style="@style/Orbit.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/care_pink_light"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/assistant_connection_required"
            android:textColor="@color/care_pink"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Clean Bottom Composer Bar -->
    <LinearLayout
        android:id="@+id/composerRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/care_surface"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_composer_container"
            android:orientation="vertical"
            android:padding="12dp">

            <EditText
                android:id="@+id/composerInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:clickable="true"
                android:cursorVisible="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="top|start"
                android:hint="@string/assistant_composer_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxHeight="120dp"
                android:minHeight="40dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textCursorDrawable="@drawable/cursor_care_pink"
                android:textColor="@color/care_ink"
                android:textColorHint="@color/care_text_muted"
                android:textColorHighlight="@color/care_pink_soft_strong"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/composerContextToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_source_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:id="@+id/composerContextIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_huge_shield_24"
                        app:tint="@color/care_pink" />

                    <TextView
                        android:id="@+id/composerContextText"
                        style="@style/Orbit.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Context: Allowed"
                        android:textColor="@color/care_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Send Button: Care Pink Circle with White Icon -->
                <FrameLayout
                    android:id="@+id/btnSendContainer"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_send_button"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/btnSendIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/assistant_send"
                        android:src="@drawable/ic_huge_send_24"
                        app:tint="#FFFFFF" />

                    <ProgressBar
                        android:id="@+id/btnSendProgress"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#FFFFFF"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
