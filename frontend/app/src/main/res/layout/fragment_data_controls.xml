<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/care_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="48dp">

        <!-- Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Orbit.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/controls_title"
                android:textColor="@color/care_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/controls_subtitle"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- AI Health Context Preference -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/controls_ai_context_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/controls_ai_context_desc"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageAiContext"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:text="@string/controls_ai_context_manage"
                android:textColor="@color/care_pink"
                android:textSize="12.5sp"
                app:strokeColor="@color/care_pink" />
        </LinearLayout>

        <!-- Clear Local Cache -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/controls_clear_cache_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/controls_clear_cache_desc"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearCache"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#2E171E"
                android:text="@string/controls_clear_cache_btn"
                android:textColor="@color/care_pink"
                android:textSize="13sp"
                app:icon="@drawable/ic_huge_delete_24"
                app:iconTint="@color/care_pink" />
        </LinearLayout>

        <!-- Deletion Policy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/controls_delete_policy_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/controls_delete_policy_desc"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
