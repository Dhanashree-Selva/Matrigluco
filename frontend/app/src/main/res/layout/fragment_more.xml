<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/care_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="48dp">

        <!-- 1. Profile Summary Card -->
        <LinearLayout
            android:id="@+id/cardProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_more_item_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Avatar Initial Circle -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_more_avatar_ring">

                <TextView
                    android:id="@+id/avatarInitial"
                    style="@style/Orbit.Text.LabelStrong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/care_pink"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="M" />
            </FrameLayout>

            <!-- User Info & Pregnancy Metadata -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/userName"
                    style="@style/Orbit.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/care_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Matrigluco Care Member" />

                <TextView
                    android:id="@+id/userEmail"
                    style="@style/Orbit.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/care_text_secondary"
                    android:textSize="12.5sp"
                    tools:text="patient@matrigluco.care" />

                <TextView
                    android:id="@+id/pregnancyBadge"
                    style="@style/Orbit.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_source_pill"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="Gestational Health Workspace · Week 27"
                    android:textColor="@color/care_pink"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_huge_chevron_right_24"
                app:tint="@color/care_text_tertiary" />
        </LinearLayout>

        <!-- 2. Section: Care & Clinical Tools -->
        <TextView
            style="@style/Orbit.Text.Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/more_section_care"
            android:textColor="@color/care_pink" />

        <!-- Item: Health Chronicle -->
        <LinearLayout
            android:id="@+id/itemHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_more_item_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_badge">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_huge_history_24"
                    app:tint="@color/care_pink" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Orbit.Text.LabelStrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/more_history_title"
                    android:textColor="@color/care_text_primary"
                    android:textSize="14.5sp" />

                <TextView
                    style="@style/Orbit.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/more_history_desc"
                    android:textColor="@color/care_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_huge_chevron_right_24"
                app:tint="@color/care_text_tertiary" />
        </LinearLayout>

        <!-- Item: Medical Reports Vault -->
        <LinearLayout
            android:id="@+id/itemReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_more_item_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_badge">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_huge_document_24"
                    app:tint="@color/care_pink" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Orbit.Text.LabelStrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/more_reports_title"
                    android:textColor="@color/care_text_primary"
                    android:textSize="14.5sp" />

                <TextView
                    style="@style/Orbit.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/more_reports_desc"
                    android:textColor="@color/care_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_huge_chevron_right_24"
                app:tint="@color/care_text_tertiary" />
        </LinearLayout>

        <!-- Item: Risk Assessment Evaluation -->
        <LinearLayout
            android:id="@+id/itemAssessment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_more_item_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_badge">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_huge_assessment_24"
                    app:tint="@color/care_pink" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Orbit.Text.LabelStrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/more_assessment_title"
                    android:textColor="@color/care_text_primary"
                    android:textSize="14.5sp" />

                <TextView
                    style="@style/Orbit.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/more_assessment_desc"
                    android:textColor="@color/care_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_huge_chevron_right_24"
                app:tint="@color/care_text_tertiary" />
        </LinearLayout>

        <!-- 3. Section: Communication & Security -->
        <TextView
            style="@style/Orbit.Text.Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/more_section_preferences"
            android:textColor="@color/care_pink" />

        <!-- Item: Notifications & Alerts -->
        <LinearLayout
            android:id="@+id/itemNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_more_item_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_badge">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_huge_notification_24"
                    app:tint="@color/care_pink" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Orbit.Text.LabelStrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/more_notifications_title"
                    android:textColor="@color/care_text_primary"
                    android:textSize="14.5sp" />

                <TextView
                    style="@style/Orbit.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/more_notifications_desc"
                    android:textColor="@color/care_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_huge_chevron_right_24"
                app:tint="@color/care_text_tertiary" />
        </LinearLayout>

        <!-- Item: Account & Security -->
        <LinearLayout
            android:id="@+id/itemAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_more_item_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_badge">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_huge_lock_24"
                    app:tint="@color/care_pink" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Orbit.Text.LabelStrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/more_account_title"
                    android:textColor="@color/care_text_primary"
                    android:textSize="14.5sp" />

                <TextView
                    style="@style/Orbit.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/more_account_desc"
                    android:textColor="@color/care_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_huge_chevron_right_24"
                app:tint="@color/care_text_tertiary" />
        </LinearLayout>

        <!-- 4. Section: Legal & Transparency -->
        <TextView
            style="@style/Orbit.Text.Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/more_section_trust"
            android:textColor="@color/care_pink" />

        <!-- Item: Trust & Transparency -->
        <LinearLayout
            android:id="@+id/itemTrustAndTransparency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_more_item_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_badge">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_huge_shield_24"
                    app:tint="@color/care_pink" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Orbit.Text.LabelStrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/more_trust_title"
                    android:textColor="@color/care_text_primary"
                    android:textSize="14.5sp" />

                <TextView
                    style="@style/Orbit.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/more_trust_desc"
                    android:textColor="@color/care_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_huge_chevron_right_24"
                app:tint="@color/care_text_tertiary" />
        </LinearLayout>

        <!-- 5. Sign Out Button Card -->
        <LinearLayout
            android:id="@+id/btnSignOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_sign_out_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_huge_lock_24"
                app:tint="@color/care_pink" />

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sign_out"
                android:textColor="@color/care_pink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_huge_chevron_right_24"
                app:tint="@color/care_pink" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
