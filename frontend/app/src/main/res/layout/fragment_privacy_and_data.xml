<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/care_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="48dp">

        <!-- Header Notice -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Orbit.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_title"
                android:textColor="@color/care_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/privacy_subtitle"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Section 1: Device Data -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_sec_device_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/privacy_sec_device_body"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Section 2: Backend Data -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_sec_backend_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/privacy_sec_backend_body"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Section 3: Health Measurements -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_sec_tracking_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/privacy_sec_tracking_body"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Section 4: Risk Assessments -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_sec_assess_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/privacy_sec_assess_body"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Section 5: Private Medical Reports -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_sec_reports_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/privacy_sec_reports_body"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Section 6: AI Assistant Context -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_sec_ai_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/privacy_sec_ai_body"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Section 7: Local Cache & Retention -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_sec_retention_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/privacy_sec_retention_body"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
