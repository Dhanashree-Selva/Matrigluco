<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/care_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="48dp">

        <!-- Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Orbit.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reports_proc_title"
                android:textColor="@color/care_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/reports_proc_subtitle"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Process Step 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reports_step_1_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/reports_step_1_desc"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Process Step 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reports_step_2_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/reports_step_2_desc"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Process Step 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reports_step_3_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/reports_step_3_desc"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Process Step 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reports_step_4_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/reports_step_4_desc"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
