<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/care_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="48dp">

        <!-- Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Orbit.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/model_title"
                android:textColor="@color/care_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/model_subtitle"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Assessment Model Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_icon_badge">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_huge_assessment_24"
                        app:tint="@color/care_pink" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Orbit.Text.LabelStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/model_assess_card_title"
                        android:textColor="@color/care_text_primary"
                        android:textSize="14.5sp" />

                    <TextView
                        style="@style/Orbit.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/model_assess_version"
                        android:textColor="@color/care_pink"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/model_assess_desc"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />

            <TextView
                style="@style/Orbit.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_source_pill"
                android:padding="10dp"
                android:text="Inputs: Age, Pregnancies, Glucose, BloodPressure, SkinThickness, Insulin, BMI, DiabetesPedigree (8 structural feature contract)"
                android:textColor="@color/care_text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Assistant Model Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_icon_badge">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_huge_message_24"
                        app:tint="@color/care_pink" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Orbit.Text.LabelStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/model_assistant_card_title"
                        android:textColor="@color/care_text_primary"
                        android:textSize="14.5sp" />

                    <TextView
                        style="@style/Orbit.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/model_assistant_runtime"
                        android:textColor="@color/care_pink"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/model_assistant_desc"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />

            <TextView
                style="@style/Orbit.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_source_pill"
                android:padding="10dp"
                android:text="Inference Location: FastAPI Backend Service. Android device communicates via authenticated REST/SSE endpoints."
                android:textColor="@color/care_text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
