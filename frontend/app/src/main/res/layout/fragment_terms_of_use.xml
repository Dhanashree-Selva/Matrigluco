<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/care_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="48dp">

        <!-- Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Orbit.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/terms_title"
                android:textColor="@color/care_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Orbit.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/terms_version"
                android:textColor="@color/care_pink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/terms_subtitle"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- OrbitImportantNotice: Medical Disclaimer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_notice_box"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_huge_warning_24"
                    app:tint="@color/care_pink" />

                <TextView
                    style="@style/Orbit.Text.LabelStrong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/legal_medical_disclaimer_title"
                    android:textColor="@color/care_pink"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/legal_medical_disclaimer_body"
                android:textColor="@color/care_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Section 1: Purpose -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/terms_sec_purpose_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/terms_sec_purpose_body"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Section 2: Intended Use -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/terms_sec_eligibility_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/terms_sec_eligibility_body"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Section 3: Account Security -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/terms_sec_security_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/terms_sec_security_body"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Section 4: Reports Ownership -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/terms_sec_reports_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/terms_sec_reports_body"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Section 5: Availability -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_disclosure_block"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Orbit.Text.LabelStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/terms_sec_availability_title"
                android:textColor="@color/care_pink"
                android:textSize="14sp" />

            <TextView
                style="@style/Orbit.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/terms_sec_availability_body"
                android:textColor="@color/care_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
