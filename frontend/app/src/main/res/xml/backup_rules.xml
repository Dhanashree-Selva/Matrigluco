<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules are intentionally explicit for Matrigluco application data.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="database" path="matrigluco_cache.db" />
    <exclude domain="database" path="matrigluco_cache.db-shm" />
    <exclude domain="database" path="matrigluco_cache.db-wal" />
    <exclude domain="root" path="auth/" />
    <exclude domain="file" path="datastore/app_preferences.preferences_pb" />
</full-backup-content>
