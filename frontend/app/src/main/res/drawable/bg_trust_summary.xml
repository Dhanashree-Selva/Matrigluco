<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/care_pink_translucent">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#1E171E"
                android:endColor="#19171C"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/care_pink_translucent" />
        </shape>
    </item>
</ripple>
