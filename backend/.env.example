# =============================================================================
# MatriGluco — Environment Configuration Contract (.env.example)
# Note: This is safe documentation with non-secret examples.
# Copy to .env and configure local passwords. Never commit real credentials!
# =============================================================================

# =========================================================
# Application
# =========================================================

APP_NAME=Matrigluco
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

FRONTEND_ORIGINS=http://localhost:5173


# =========================================================
# MySQL / MariaDB (Use dedicated matrigluco_app account)
# =========================================================

DATABASE_URL=mysql+pymysql://matrigluco_app:CHANGE_ME@127.0.0.1:3306/matrigluco?charset=utf8mb4

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true


# =========================================================
# Authentication (Argon2id + JWT)
# =========================================================

JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14


# =========================================================
# Redis (Transient Caching & Distributed Locks)
# =========================================================

REDIS_URL=redis://127.0.0.1:6379/0

CACHE_DEFAULT_TTL_SECONDS=300


# =========================================================
# Celery (Background Worker & Periodic Scheduler)
# =========================================================

CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

CELERY_TASK_ALWAYS_EAGER=false


# =========================================================
# Storage (Private Medical Files & Outputs)
# =========================================================

STORAGE_PROVIDER=local

PRIVATE_STORAGE_ROOT=storage/private

MAX_UPLOAD_SIZE_MB=10

ALLOWED_REPORT_MIME_TYPES=application/pdf,image/jpeg,image/png


# =========================================================
# Traditional ML (Clinical Maternal Diabetes Risk)
# =========================================================

ML_MODEL_KEY=diabetes-risk
ML_MODEL_VERSION=1.0.0

ML_ARTIFACT_ROOT=app/ml/artifacts

ML_PRELOAD=true


# =========================================================
# Local AI Chatbot (Offline llama.cpp / GGUF)
# =========================================================

AI_ENABLED=false

AI_MODEL_PATH=storage/ai/models/model.gguf
AI_MODEL_NAME=llama-3.2-3b-instruct
AI_MODEL_VERSION=1.0.0

AI_MODEL_CHECKSUM=

AI_PRELOAD_MODEL=false

AI_CONTEXT_SIZE=4096
AI_MAX_OUTPUT_TOKENS=512

AI_TEMPERATURE=0.2
AI_TOP_P=0.9
AI_TOP_K=40

AI_THREADS=
AI_BATCH_SIZE=
AI_GPU_LAYERS=0


# =========================================================
# AI / RAG (Clinical Knowledge Guidelines & Retrieval)
# =========================================================

AI_KNOWLEDGE_ROOT=storage/private/knowledge-documents
AI_INDEX_ROOT=storage/ai/indexes

AI_RAG_ENABLED=false
AI_RAG_TOP_K=5


# =========================================================
# OCR (Medical Lab Report Biomarker Parsing)
# =========================================================

OCR_PROVIDER=ocr_space
OCR_API_KEY=

OCR_TIMEOUT_SECONDS=30


# =========================================================
# Logging (Structured Console / JSON Output)
# =========================================================

LOG_LEVEL=INFO
LOG_JSON=false
